# Vault settings. Copy to .env for local runs.

# Where Cockpit runs. Vault accepts its launch tickets and nothing else.
COCKPIT_URL=http://localhost:5173
# Without Cockpit, a password-less developer sign-in (never in production).
DEV_SIGNIN=on

# Postgres. Without it, development keeps everything in memory and forgets on restart.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/vault

# Signs session tokens. Random per start when blank.
# SESSION_SECRET=

# Lets Cockpit's server read activity counts (GET /api/cockpit/rollup).
# VAULT_SERVICE_TOKEN=

# The organization's calendar: "today" and the check-in window are counted in it.
TZ_DISPLAY=America/Los_Angeles

PORT=8796
